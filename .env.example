# Copy this file to .env.local and add your credentials.
FORTYGUARD_API_KEY=
OPENROUTESERVICE_API_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public Supabase browser credentials. Access is protected by Clerk tokens and
# organization-scoped Row Level Security; never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Firebase web app configuration and public Web Push certificate. These values
# are public browser configuration; the Admin credentials below remain secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin service-account credentials used only by the protected push
# endpoint. Keep FIREBASE_PRIVATE_KEY in .env.local and Vercel, never in Git.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional probe tuning.
FORTYGUARD_POLL_INTERVAL_MS=10000
FORTYGUARD_POLL_TIMEOUT_MS=300000
