# Copy this file to .env.local and add your credentials.
FORTYGUARD_API_KEY=
OPENROUTESERVICE_API_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public Supabase browser credentials. Access is protected by Clerk tokens and
# organization-scoped Row Level Security; never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional probe tuning.
FORTYGUARD_POLL_INTERVAL_MS=10000
FORTYGUARD_POLL_TIMEOUT_MS=300000
